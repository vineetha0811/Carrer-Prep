# To enable live LLM-powered question generation & evaluation, set:
# AI_API_KEY=your_openrouter_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Client
VITE_API_URL=http://localhost:5000/api
